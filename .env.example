# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# Порт сервера.
PORT=3000

# Ключ для страницы /admin.html (отзывы и удаление строк из таблицы).
# Придумайте длинную случайную строку, например: openssl rand -hex 24
ADMIN_KEY=

# Пересылка отзывов в Telegram (необязательно).
# TG_TOKEN — токен бота от @BotFather, TG_CHAT — id вашего чата или группы (узнать: @userinfobot).
TG_TOKEN=
TG_CHAT=

# Где лежит база. По умолчанию data/megalul.db рядом с server.js.
# DB_PATH=/var/lib/megalul/megalul.db
