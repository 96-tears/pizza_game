# systemd-служба для VPS. Положить в /etc/systemd/system/megalul.service, затем:
#   sudo systemctl daemon-reload && sudo systemctl enable --now megalul
[Unit]
Description=Megalul game server
After=network.target

[Service]
Type=simple
User=megalul
WorkingDirectory=/opt/megalul
EnvironmentFile=/opt/megalul/.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
